+auto CodeGenerator::appendSingleQubitLayer(const size_t nQubits,
+                                           const SingleQubitGateLayer& layer,
+                                           NAComputation& code) const -> void {
+  std::vector<std::reference_wrapper<const Atom>> atoms;
+  atoms.reserve(code.getAtoms().size());
+  for (const auto& atom : code.getAtoms()) {
+    atoms.emplace_back(*atom);
+  }
+  assert(!code.getZones().empty());
+  appendSingleQubitGates(nQubits, layer, atoms, *code.getZones().back(), code);
+}
+
+auto CodeGenerator::appendTwoQubitLayer(const Placement& currentPlacement,
+                                        const Routing& executionRouting,
+                                        const Placement& executionPlacement,
+                                        const Routing& targetRouting,
+                                        const Placement& targetPlacement,
+                                        NAComputation& code) const -> void {
+  std::vector<std::reference_wrapper<const Atom>> atoms;
+  atoms.reserve(code.getAtoms().size());
+  for (const auto& atom : code.getAtoms()) {
+    atoms.emplace_back(*atom);
+  }
+  std::vector<std::reference_wrapper<const Zone>> rydbergZones;
+  assert(!code.getZones().empty());
+  rydbergZones.reserve(code.getZones().size() - 1);
+  for (auto zone = code.getZones().cbegin();
+       std::next(zone) != code.getZones().cend(); ++zone) {
+    rydbergZones.emplace_back(**zone);
+  }
+  appendTwoQubitGates(currentPlacement, executionRouting, executionPlacement,
+                      targetRouting, targetPlacement, atoms, rydbergZones,
+                      code);
+}
