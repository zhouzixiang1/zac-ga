+  auto scheduledLayers = makeScheduledLayersIncrementally(scheduler, circuit);
+  const auto batchSchedule = scheduler.schedule(circuit);
+  const auto& batchSingleQubitGateLayers = batchSchedule.first;
+  const auto& batchTwoQubitGateLayers = batchSchedule.second;
+  expectSingleQubitLayersEqual(batchSingleQubitGateLayers, scheduledLayers);
+  ASSERT_EQ(scheduledLayers.size(), batchTwoQubitGateLayers.size() + 1);
+  for (size_t layer = 0; layer < batchTwoQubitGateLayers.size(); ++layer) {
+    ASSERT_TRUE(scheduledLayers[layer].twoQubitGates);
+    EXPECT_EQ(*scheduledLayers[layer].twoQubitGates,
+              batchTwoQubitGateLayers[layer]);
