+/** A scheduled layer supplied to the stateful streaming compiler. */
+struct ScheduledLayer {
+  /// Single-qubit operations executed before the optional two-qubit layer.
+  SingleQubitGateLayer singleQubitGates;
+  /// The following two-qubit layer. Only the final item omits this value.
+  std::optional<TwoQubitGateLayer> twoQubitGates;
+  /// Optional ownership backing references in singleQubitGates.
+  std::vector<std::shared_ptr<const qc::Operation>> ownedSingleQubitOperations;
+};
+
+/** Metadata accompanying the first native-code chunk. */
+struct StreamingInitialPlacement {
+  Placement placement;
+};
+
+/** Metadata accompanying one compiled two-qubit-layer transition. */
+struct StreamingTransition {
+  size_t layer;
+  std::unordered_set<qc::Qubit> previousReuseQubits;
+  std::unordered_set<qc::Qubit> nextReuseQubits;
+  Placement previousPlacement;
+  Placement gatePlacement;
+  Placement storagePlacement;
+  Routing executionRouting;
+  Routing storageRouting;
+};
+
+using StreamingChunkMetadata =
+    std::variant<StreamingInitialPlacement, StreamingTransition>;
+using ScheduledLayerProvider = std::function<std::optional<ScheduledLayer>()>;
+using StreamingChunkConsumer =
+    std::function<void(const StreamingChunkMetadata&, const NAComputation&)>;
+
@@ -239,0 +279,149 @@ public:
+
+  /**
+   * Compile a pre-scheduled circuit one layer at a time.
+   *
+   * @details The provider is called sequentially and is expected to return one
+   * item for every single-qubit layer. Each item except the last also contains
+   * the two-qubit layer that follows it. Such a provider can be populated in a
+   * first pass with `ASAPScheduler::scheduleOperation`. Only the current and
+   * next provider items are retained so that adjacent-layer reuse and the
+   * routing-aware lookahead are exactly equivalent to the batch compiler.
+   *
+   * The consumer is first called with the initial placement and a computation
+   * containing the initial state followed by the first single-qubit layer. It
+   * is then called once per two-qubit layer with both rearrangements, the CZ,
+   * and the following single-qubit layer. The operations are cleared
+   * immediately after every callback; atoms, zones, and initial locations stay
+   * alive for the entire compilation. Later chunks are transitions from the
+   * preceding chunk's final placement and therefore must be validated by a
+   * stateful consumer rather than as stand-alone `NAComputation` objects.
+   *
+   * @note This exact transition interface currently requires AStarPlacer.
+   * @param nQubits number of circuit qubits
+   * @param provider sequential source of scheduled layers
+   * @param consumer synchronous consumer for native-code chunks and metadata
+   */
+  template <class P = Placer,
+            std::enable_if_t<std::is_same_v<P, AStarPlacer>, int> = 0>
+  auto compileStreaming(const size_t nQubits, ScheduledLayerProvider provider,
+                        const StreamingChunkConsumer& consumer) -> void {
+    statistics_ = {};
+    const auto readScheduledLayer = [&]() {
+      const auto start = std::chrono::system_clock::now();
+      auto layer = provider();
+      statistics_.schedulingTime +=
+          std::chrono::duration_cast<std::chrono::microseconds>(
+              std::chrono::system_clock::now() - start)
+              .count();
+      return layer;
+    };
+    auto currentLayer = readScheduledLayer();
+    auto nextLayer =
+        currentLayer ? readScheduledLayer() : std::optional<ScheduledLayer>{};
+    const auto validateProviderWindow = [&]() {
+      if (currentLayer && currentLayer->twoQubitGates && !nextLayer) {
+        throw std::invalid_argument(
+            "A two-qubit layer must be followed by a single-qubit layer.");
+      }
+      if (currentLayer && !currentLayer->twoQubitGates && nextLayer) {
+        throw std::invalid_argument(
+            "Only the final scheduled layer may omit its two-qubit layer.");
+      }
+    };
+    validateProviderWindow();
+
+    auto start = std::chrono::system_clock::now();
+    auto previousPlacement = SELF.placeInitial(nQubits);
+    statistics_.placementTime +=
+        std::chrono::duration_cast<std::chrono::microseconds>(
+            std::chrono::system_clock::now() - start)
+            .count();
+
+    start = std::chrono::system_clock::now();
+    auto code = SELF.initialize(previousPlacement);
+    if (currentLayer) {
+      SELF.appendSingleQubitLayer(nQubits, currentLayer->singleQubitGates,
+                                  code);
+    }
+    statistics_.codeGenerationTime +=
+        std::chrono::duration_cast<std::chrono::microseconds>(
+            std::chrono::system_clock::now() - start)
+            .count();
+    assert(code.validate().first);
+    consumer(
+        StreamingChunkMetadata{StreamingInitialPlacement{previousPlacement}},
+        code);
+    code.clear();
+
+    std::unordered_set<qc::Qubit> previousReuseQubits;
+    size_t layer = 0;
+    while (currentLayer && currentLayer->twoQubitGates) {
+      assert(nextLayer);
+      const auto& currentTwoQubitGates = *currentLayer->twoQubitGates;
+      const TwoQubitGateLayer emptyNextTwoQubitGates;
+      const auto& nextTwoQubitGates = nextLayer->twoQubitGates
+                                          ? *nextLayer->twoQubitGates
+                                          : emptyNextTwoQubitGates;
+
+      start = std::chrono::system_clock::now();
+      auto nextReuseQubits =
+          nextLayer->twoQubitGates
+              ? SELF.analyzeTransition(currentTwoQubitGates, nextTwoQubitGates)
+              : std::unordered_set<qc::Qubit>{};
+      statistics_.reuseAnalysisTime +=
+          std::chrono::duration_cast<std::chrono::microseconds>(
+              std::chrono::system_clock::now() - start)
+              .count();
+
+      start = std::chrono::system_clock::now();
+      auto [gatePlacement, storagePlacement] = SELF.placeLayer(
+          previousPlacement, previousReuseQubits, nextReuseQubits,
+          currentTwoQubitGates, nextTwoQubitGates);
+      statistics_.placementTime +=
+          std::chrono::duration_cast<std::chrono::microseconds>(
+              std::chrono::system_clock::now() - start)
+              .count();
+
+      start = std::chrono::system_clock::now();
+      auto executionRouting =
+          SELF.routeTransition(previousPlacement, gatePlacement);
+      auto storageRouting =
+          SELF.routeTransition(gatePlacement, storagePlacement);
+      statistics_.routingTime +=
+          std::chrono::duration_cast<std::chrono::microseconds>(
+              std::chrono::system_clock::now() - start)
+              .count();
+
+      start = std::chrono::system_clock::now();
+      SELF.appendTwoQubitLayer(previousPlacement, executionRouting,
+                               gatePlacement, storageRouting, storagePlacement,
+                               code);
+      SELF.appendSingleQubitLayer(nQubits, nextLayer->singleQubitGates, code);
+      statistics_.codeGenerationTime +=
+          std::chrono::duration_cast<std::chrono::microseconds>(
+              std::chrono::system_clock::now() - start)
+              .count();
+      const StreamingTransition transition{layer,
+                                           previousReuseQubits,
+                                           nextReuseQubits,
+                                           previousPlacement,
+                                           gatePlacement,
+                                           storagePlacement,
+                                           executionRouting,
+                                           storageRouting};
+      consumer(StreamingChunkMetadata{transition}, code);
+      code.clear();
+
+      previousPlacement = std::move(storagePlacement);
+      previousReuseQubits = std::move(nextReuseQubits);
+      currentLayer = std::move(nextLayer);
+      nextLayer = readScheduledLayer();
+      validateProviderWindow();
+      ++layer;
+    }
+    statistics_.totalTime =
+        statistics_.schedulingTime + statistics_.reuseAnalysisTime +
+        statistics_.placementTime + statistics_.routingTime +
+        statistics_.codeGenerationTime;
+  }
+
