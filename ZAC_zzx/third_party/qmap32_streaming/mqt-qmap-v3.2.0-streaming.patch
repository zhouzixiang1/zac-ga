+
+#pragma once
+
+#include "na/zoned/Compiler.hpp"
+
+#include <cstddef>
+#include <filesystem>
+#include <memory>
+#include <optional>
+#include <string>
+
+namespace na::zoned {
+
+/** Frozen metadata of a qmap-schedule-store-v1 database. */
+struct SQLiteScheduleMetadata {
+  std::string format;
+  size_t qubits;
+  size_t events;
+  size_t gates1Q;
+  size_t gates2Q;
+  size_t twoQubitLayers;
+  size_t scheduledItems;
+};
+
+/** Read scheduled QMAP layers from SQLite while owning only one layer at a
+ * time. */
+class SQLiteScheduledLayerProvider {
+  struct Impl;
+  std::unique_ptr<Impl> impl_;
+
+public:
+  explicit SQLiteScheduledLayerProvider(const std::filesystem::path& path);
+  ~SQLiteScheduledLayerProvider();
+  SQLiteScheduledLayerProvider(SQLiteScheduledLayerProvider&&) noexcept;
+  auto operator=(SQLiteScheduledLayerProvider&&) noexcept
+      -> SQLiteScheduledLayerProvider&;
+  SQLiteScheduledLayerProvider(const SQLiteScheduledLayerProvider&) = delete;
+  auto operator=(const SQLiteScheduledLayerProvider&)
+      -> SQLiteScheduledLayerProvider& = delete;
+
+  /** Return the next scheduled item or nullopt after the frozen final item. */
+  [[nodiscard]] auto next() -> std::optional<ScheduledLayer>;
+
+  [[nodiscard]] auto metadata() const -> const SQLiteScheduleMetadata&;
+};
+
+/** Inputs and outputs for one SQLite-backed routing-aware compilation. */
+struct SQLiteStreamingCompileOptions {
+  std::filesystem::path scheduleDatabase;
+  std::filesystem::path architectureJson;
+  std::filesystem::path compilerConfigJson;
+  std::filesystem::path nativeOutput;
+  std::filesystem::path metadataJsonlOutput;
+};
+
+/** Small, bounded result retained after a streaming compilation. */
+struct SQLiteStreamingCompileResult {
+  SQLiteScheduleMetadata schedule;
+  size_t chunks;
+  size_t peakNativeOperationsPerChunk;
+  RoutingAwareCompiler::Statistics statistics;
+};
+
+/** Compile a frozen SQLite schedule and atomically publish native and metadata
+ * streams. */
+[[nodiscard]] auto
+compileSQLiteSchedule(const SQLiteStreamingCompileOptions& options)
+    -> SQLiteStreamingCompileResult;
+
+} // namespace na::zoned
