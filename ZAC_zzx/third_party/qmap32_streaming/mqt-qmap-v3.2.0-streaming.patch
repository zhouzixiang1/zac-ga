+TEST_F(VertexMatchingReuseAnalyzerAnalyzeTest,
+       TransitionMatchesBatchAnalysisExactly) {
+  const std::vector<TwoQubitGateLayer> twoQubitGateLayers{
+      {{0, 1}, {2, 3}}, {{0, 2}, {1, 4}}, {{0, 2}, {3, 4}}, {}};
+
+  const auto batchReuse = analyzer.analyzeReuse(twoQubitGateLayers);
+  ASSERT_EQ(batchReuse.size(), twoQubitGateLayers.size() - 1);
+  for (std::size_t layer = 1; layer < twoQubitGateLayers.size(); ++layer) {
+    EXPECT_EQ(batchReuse[layer - 1],
+              analyzer.analyzeTransition(twoQubitGateLayers[layer - 1],
+                                         twoQubitGateLayers[layer]));
+  }
+
+  // Both qubits occur in the current layer but in different gates. QMAP 3.2
+  // deliberately keeps the first reusable qubit because this is an else-if.
+  EXPECT_THAT(
+      analyzer.analyzeTransition(twoQubitGateLayers[0], twoQubitGateLayers[1]),
+      ::testing::UnorderedElementsAre(0U));
+}
