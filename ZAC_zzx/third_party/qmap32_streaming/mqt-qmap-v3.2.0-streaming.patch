+#include "na/zoned/streaming/SQLiteStreaming.hpp"
+
+#include <charconv>
+#include <cstddef>
+#include <exception>
+#include <iostream>
+#include <nlohmann/json.hpp>
+#include <stdexcept>
+#include <string>
+#include <string_view>
+#include <system_error>
+
+namespace {
+auto printUsage(const char* executable) -> void {
+  std::cout << "Usage: " << executable
+            << " <schedule.sqlite> <architecture.json> <compiler-config.json>"
+               " <native-output> <metadata-jsonl-output>\n"
+            << "       " << executable
+            << " --inspect-schedule <schedule.sqlite> <layer-count>\n";
+}
+
+[[nodiscard]] auto parseLayerCount(const std::string_view value) -> size_t {
+  size_t result = 0;
+  const auto [end, error] =
+      std::from_chars(value.data(), value.data() + value.size(), result);
+  if (error != std::errc{} || end != value.data() + value.size()) {
+    throw std::invalid_argument("layer-count must be a non-negative integer");
+  }
+  return result;
+}
+} // namespace
+
+auto main(const int argc, char** argv) -> int {
+  if (argc == 2 && std::string_view(argv[1]) == "--help") {
+    printUsage(argv[0]);
+    return 0;
+  }
+  if (argc == 4 && std::string_view(argv[1]) == "--inspect-schedule") {
+    try {
+      na::zoned::SQLiteScheduledLayerProvider provider(argv[2]);
+      const auto requestedLayers = parseLayerCount(argv[3]);
+      const auto& metadata = provider.metadata();
+      std::cout << "format=" << metadata.format << " qubits=" << metadata.qubits
+                << " events=" << metadata.events
+                << " gates_1q=" << metadata.gates1Q
+                << " gates_2q=" << metadata.gates2Q
+                << " two_qubit_layers=" << metadata.twoQubitLayers
+                << " scheduled_items=" << metadata.scheduledItems << '\n';
+      for (size_t index = 0; index < requestedLayers; ++index) {
+        auto layer = provider.next();
+        if (!layer) {
+          throw std::runtime_error(
+              "requested layer-count exceeds scheduled_items");
+        }
+        std::cout << "item=" << index
+                  << " gates_1q=" << layer->singleQubitGates.size()
+                  << " gates_2q="
+                  << (layer->twoQubitGates ? layer->twoQubitGates->size() : 0)
+                  << " final=" << (!layer->twoQubitGates) << '\n';
+      }
+      return 0;
+    } catch (const std::exception& error) {
+      std::cerr << "qmap schedule inspection failed: " << error.what() << '\n';
+      return 1;
+    }
+  }
+  if (argc != 6) {
+    printUsage(argv[0]);
+    return 2;
+  }
+  try {
+    const na::zoned::SQLiteStreamingCompileOptions options{
+        argv[1], argv[2], argv[3], argv[4], argv[5]};
+    const auto result = na::zoned::compileSQLiteSchedule(options);
+    const nlohmann::json summary{
+        {"schema", "qmap-stream-cli-result-v1"},
+        {"events", result.schedule.events},
+        {"two_qubit_layers", result.schedule.twoQubitLayers},
+        {"chunks", result.chunks},
+        {"peak_native_operations_per_chunk",
+         result.peakNativeOperationsPerChunk},
+        {"statistics", result.statistics}};
+    std::cout << summary.dump() << '\n';
+    return 0;
+  } catch (const std::exception& error) {
+    std::cerr << "qmap streaming compilation failed: " << error.what() << '\n';
+    return 1;
+  }
+}
