+auto ASAPScheduler::scheduleOperation(const qc::Operation& op,
+                                      State& state) const -> Assignment {
+  assert(state.nextLayerForQubit.size() == state.nQubits);
+  if (op.getType() == qc::Barrier) {
+    if (op.getNqubits() < state.nQubits) {
+      throw std::invalid_argument("Only global barriers are allowed.");
+    }
+    const auto layer = state.twoQubitGateCounts.size();
+    std::fill(state.nextLayerForQubit.begin(), state.nextLayerForQubit.end(),
+              layer);
+    return Assignment{OperationKind::Barrier, layer};
+  }
+  if (op.isGlobal(state.nQubits) && !op.isControlled() && state.nQubits > 1) {
+    const auto layer = *std::max_element(state.nextLayerForQubit.cbegin(),
+                                         state.nextLayerForQubit.cend());
+    std::fill(state.nextLayerForQubit.begin(), state.nextLayerForQubit.end(),
+              layer);
+    return Assignment{OperationKind::SingleQubit, layer};
+  }
+  if (op.isStandardOperation()) {
+    const auto& stdOp = dynamic_cast<const qc::StandardOperation&>(op);
+    if (stdOp.getNtargets() == 1 && stdOp.getNcontrols() == 0) {
+      return Assignment{OperationKind::SingleQubit,
+                        state.nextLayerForQubit[stdOp.getTargets().front()]};
+    }
+    if (stdOp.getType() == qc::Z && stdOp.getNtargets() == 1 &&
+        stdOp.getNcontrols() == 1) {
+      const auto qubit1 = stdOp.getTargets().front();
+      const auto qubit2 = stdOp.getControls().cbegin()->qubit;
+      auto layer = std::max(state.nextLayerForQubit[qubit1],
+                            state.nextLayerForQubit[qubit2]);
+      while (layer < state.twoQubitGateCounts.size() &&
+             state.twoQubitGateCounts[layer] >= maxTwoQubitGateNumPerLayer_) {
+        ++layer;
+      }
+      assert(layer <= state.twoQubitGateCounts.size());
+      if (layer == state.twoQubitGateCounts.size()) {
+        state.twoQubitGateCounts.emplace_back(0);
+      }
+      ++state.twoQubitGateCounts[layer];
+      state.nextLayerForQubit[qubit1] = layer + 1;
+      state.nextLayerForQubit[qubit2] = layer + 1;
+      return Assignment{
+          OperationKind::TwoQubit, layer,
+          std::array{std::min(qubit1, qubit2), std::max(qubit1, qubit2)}};
+    }
+    std::stringstream ss;
+    ss << "Operation type not supported: " << stdOp.getType() << " with "
+       << stdOp.getNcontrols() << " controls and " << stdOp.getNtargets()
+       << " targets";
+    throw std::invalid_argument(ss.str());
+  }
+  std::stringstream ss;
+  ss << "Operation type not supported: " << op.getType() << " with "
+     << op.getNcontrols() << " controls and " << op.getNtargets() << " targets";
+  throw std::invalid_argument(ss.str());
+}
