+  EXPECT_FALSE(scheduledLayers.back().twoQubitGates);
+
+  VertexMatchingReuseAnalyzer reuseAnalyzer(architecture,
+                                            config.reuseAnalyzerConfig);
+  const auto expectedReuse =
+      reuseAnalyzer.analyzeReuse(batchTwoQubitGateLayers);
+  AStarPlacer placer(architecture, config.placerConfig);
+  const auto expectedPlacements = placer.place(
+      circuit.getNqubits(), batchTwoQubitGateLayers, expectedReuse);
+  const IndependentSetRouter router(architecture, config.routerConfig);
+  const auto expectedRoutes = router.route(expectedPlacements);
+  RoutingAwareCompiler batchCompiler(architecture, config);
+  const auto batchCode = batchCompiler.compile(circuit);
+  EXPECT_TRUE(batchCode.validate().first);
+
+  size_t nextScheduledLayer = 0;
+  const ScheduledLayerProvider provider =
+      [&]() -> std::optional<ScheduledLayer> {
+    if (nextScheduledLayer == scheduledLayers.size()) {
+      return std::nullopt;
+    }
+    return scheduledLayers[nextScheduledLayer++];
+  };
+  std::vector<Placement> streamedPlacements;
+  std::vector<std::unordered_set<qc::Qubit>> streamedReuse;
+  std::vector<Routing> streamedRoutes;
+  std::string streamedText;
+  size_t chunks = 0;
+  const StreamingChunkConsumer consumer =
+      [&](const StreamingChunkMetadata& metadata, const NAComputation& chunk) {
+        if (const auto* initial =
+                std::get_if<StreamingInitialPlacement>(&metadata)) {
+          streamedPlacements.emplace_back(initial->placement);
+          streamedText += chunk.toString();
+        } else {
+          const auto& transition = std::get<StreamingTransition>(metadata);
+          EXPECT_EQ(transition.layer, chunks - 1);
+          EXPECT_EQ(transition.previousPlacement, streamedPlacements.back());
+          if (transition.layer == 0) {
+            EXPECT_TRUE(transition.previousReuseQubits.empty());
+          } else {
+            EXPECT_EQ(transition.previousReuseQubits,
+                      expectedReuse[transition.layer - 1]);
+          }
+          streamedPlacements.emplace_back(transition.gatePlacement);
+          streamedPlacements.emplace_back(transition.storagePlacement);
+          if (transition.layer + 1 < batchTwoQubitGateLayers.size()) {
+            streamedReuse.emplace_back(transition.nextReuseQubits);
+          }
+          streamedRoutes.emplace_back(transition.executionRouting);
+          streamedRoutes.emplace_back(transition.storageRouting);
+          streamedText += compilerOperationsToString(chunk);
+        }
+        ++chunks;
+      };
+  RoutingAwareCompiler streamingCompiler(architecture, config);
+  streamingCompiler.compileStreaming(circuit.getNqubits(), provider, consumer);
+
+  EXPECT_EQ(nextScheduledLayer, scheduledLayers.size());
+  EXPECT_EQ(chunks, batchTwoQubitGateLayers.size() + 1);
+  EXPECT_EQ(streamedPlacements, expectedPlacements);
+  EXPECT_EQ(streamedReuse, expectedReuse);
+  EXPECT_EQ(streamedRoutes, expectedRoutes);
