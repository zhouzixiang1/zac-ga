+class SQLiteStatement {
+  sqlite3_stmt* statement_ = nullptr;
+
+public:
+  SQLiteStatement(sqlite3* database, const std::string_view sql) {
+    const std::string ownedSQL(sql);
+    if (sqlite3_prepare_v2(database, ownedSQL.c_str(), -1, &statement_,
+                           nullptr) != SQLITE_OK) {
+      throw std::runtime_error("SQLite prepare failed: " +
+                               std::string(sqlite3_errmsg(database)));
+    }
+  }
+
+  ~SQLiteStatement() { sqlite3_finalize(statement_); }
+  SQLiteStatement(const SQLiteStatement&) = delete;
+  auto operator=(const SQLiteStatement&) -> SQLiteStatement& = delete;
+  SQLiteStatement(SQLiteStatement&&) = delete;
+  auto operator=(SQLiteStatement&&) -> SQLiteStatement& = delete;
+
+  [[nodiscard]] auto get() const -> sqlite3_stmt* { return statement_; }
+
+  auto reset() const -> void {
+    if (sqlite3_reset(statement_) != SQLITE_OK ||
+        sqlite3_clear_bindings(statement_) != SQLITE_OK) {
+      throw std::runtime_error("SQLite statement reset failed");
+    }
+  }
+};
+
+struct SQLiteDatabaseDeleter {
+  auto operator()(sqlite3* database) const noexcept -> void {
+    if (database != nullptr) {
+      sqlite3_close_v2(database);
+    }
+  }
+};
+using SQLiteDatabase = std::unique_ptr<sqlite3, SQLiteDatabaseDeleter>;
+
+[[nodiscard]] auto openReadOnlyDatabase(const std::filesystem::path& path)
+    -> SQLiteDatabase {
+  sqlite3* rawDatabase = nullptr;
+  const auto result =
+      sqlite3_open_v2(path.string().c_str(), &rawDatabase,
+                      SQLITE_OPEN_READONLY | SQLITE_OPEN_NOMUTEX, nullptr);
+  if (result != SQLITE_OK) {
+    const auto message = rawDatabase == nullptr
+                             ? std::string("unknown SQLite error")
+                             : std::string(sqlite3_errmsg(rawDatabase));
+    SQLiteDatabaseDeleter{}(rawDatabase);
+    throw std::runtime_error("Cannot open schedule database read-only: " +
+                             message);
+  }
+  SQLiteDatabase database(rawDatabase);
+  char* error = nullptr;
+  if (sqlite3_exec(database.get(),
+                   "PRAGMA query_only=ON;PRAGMA trusted_schema=OFF;", nullptr,
+                   nullptr, &error) != SQLITE_OK) {
+    const std::string message =
+        error == nullptr ? sqlite3_errmsg(database.get()) : error;
+    sqlite3_free(error);
+    throw std::runtime_error("Cannot protect schedule database: " + message);
+  }
+  return database;
+}
+
+[[nodiscard]] auto columnInt64(sqlite3_stmt* statement, const int column,
+                               const std::string_view field) -> int64_t {
+  if (sqlite3_column_type(statement, column) != SQLITE_INTEGER) {
+    throw std::runtime_error("SQLite field is not an integer: " +
+                             std::string(field));
+  }
+  return sqlite3_column_int64(statement, column);
+}
+
+[[nodiscard]] auto columnText(sqlite3_stmt* statement, const int column,
+                              const std::string_view field) -> std::string {
+  if (sqlite3_column_type(statement, column) != SQLITE_TEXT) {
+    throw std::runtime_error("SQLite field is not text: " + std::string(field));
+  }
+  const auto* text = sqlite3_column_text(statement, column);
+  if (text == nullptr) {
+    throw std::runtime_error("SQLite text field is null: " +
+                             std::string(field));
+  }
+  return reinterpret_cast<const char*>(text);
+}
+
+[[nodiscard]] auto checkedSize(const int64_t value,
+                               const std::string_view field) -> size_t {
+  if (value < 0) {
+    throw std::runtime_error("Negative SQLite value for " + std::string(field));
+  }
+  return static_cast<size_t>(value);
+}
+
+[[nodiscard]] auto jsonSize(const nlohmann::json& value,
+                            const std::string_view field) -> size_t {
+  uint64_t converted = 0;
+  if (value.is_number_unsigned()) {
+    converted = value.get<uint64_t>();
+  } else if (value.is_number_integer()) {
+    const auto signedValue = value.get<int64_t>();
+    if (signedValue < 0) {
+      throw std::runtime_error("Negative metadata value for " +
+                               std::string(field));
+    }
+    converted = static_cast<uint64_t>(signedValue);
+  } else {
+    throw std::runtime_error("Metadata value is not an integer: " +
+                             std::string(field));
+  }
+  if (converted > static_cast<uint64_t>(std::numeric_limits<int64_t>::max()) ||
+      converted > static_cast<uint64_t>(std::numeric_limits<size_t>::max())) {
+    throw std::runtime_error("Metadata value is too large: " +
+                             std::string(field));
+  }
+  return static_cast<size_t>(converted);
+}
+
+class ExpressionParser {
+  std::string expression_;
+  size_t position_ = 0;
+
+  auto skipWhitespace() -> void {
+    while (position_ < expression_.size() &&
+           std::isspace(static_cast<unsigned char>(expression_[position_])) !=
+               0) {
+      ++position_;
+    }
+  }
+
+  [[nodiscard]] auto parsePrimary() -> double {
+    skipWhitespace();
+    if (position_ == expression_.size()) {
+      throw std::runtime_error("Unexpected end of gate parameter");
+    }
+    if (expression_[position_] == '(') {
+      ++position_;
+      const auto value = parseExpression();
+      skipWhitespace();
+      if (position_ == expression_.size() || expression_[position_] != ')') {
+        throw std::runtime_error("Unclosed gate parameter expression");
+      }
+      ++position_;
+      return value;
+    }
+    if (expression_.compare(position_, 2, "pi") == 0) {
+      position_ += 2;
+      return qc::PI;
+    }
+    char* end = nullptr;
+    const auto* begin = expression_.c_str() + position_;
+    const auto value = std::strtod(begin, &end);
+    if (end == begin) {
+      throw std::runtime_error("Invalid numeric gate parameter");
+    }
+    position_ += static_cast<size_t>(end - begin);
+    if (!std::isfinite(value)) {
+      throw std::runtime_error("Non-finite gate parameter");
+    }
+    return value;
+  }
+
+  [[nodiscard]] auto parseFactor() -> double {
+    skipWhitespace();
+    if (position_ < expression_.size() && expression_[position_] == '+') {
+      ++position_;
+      return parseFactor();
+    }
+    if (position_ < expression_.size() && expression_[position_] == '-') {
+      ++position_;
+      return -parseFactor();
+    }
+    return parsePrimary();
+  }
+
+  [[nodiscard]] auto parseTerm() -> double {
+    auto value = parseFactor();
+    while (true) {
+      skipWhitespace();
+      if (position_ == expression_.size() ||
+          (expression_[position_] != '*' && expression_[position_] != '/')) {
+        return value;
+      }
+      const auto operation = expression_[position_++];
+      const auto operand = parseFactor();
+      if (operation == '/') {
+        if (operand == 0.0) {
+          throw std::runtime_error("Division by zero in gate parameter");
+        }
+        value /= operand;
+      } else {
+        value *= operand;
+      }
+      if (!std::isfinite(value)) {
+        throw std::runtime_error("Non-finite gate parameter");
+      }
+    }
+  }
+
+  [[nodiscard]] auto parseExpression() -> double {
+    auto value = parseTerm();
+    while (true) {
+      skipWhitespace();
+      if (position_ == expression_.size() ||
+          (expression_[position_] != '+' && expression_[position_] != '-')) {
+        return value;
+      }
+      const auto operation = expression_[position_++];
+      const auto operand = parseTerm();
+      value = operation == '+' ? value + operand : value - operand;
+      if (!std::isfinite(value)) {
+        throw std::runtime_error("Non-finite gate parameter");
+      }
+    }
+  }
+
+public:
+  explicit ExpressionParser(std::string expression)
+      : expression_(std::move(expression)) {}
+
+  [[nodiscard]] auto parse() -> double {
+    const auto result = parseExpression();
+    skipWhitespace();
+    if (position_ != expression_.size()) {
+      throw std::runtime_error("Trailing input in gate parameter");
+    }
+    return result;
+  }
+};
+
+[[nodiscard]] auto trim(const std::string_view input) -> std::string_view {
+  auto first = size_t{0};
+  while (first < input.size() &&
+         std::isspace(static_cast<unsigned char>(input[first])) != 0) {
+    ++first;
+  }
+  auto last = input.size();
+  while (last > first &&
+         std::isspace(static_cast<unsigned char>(input[last - 1])) != 0) {
+    --last;
+  }
+  return input.substr(first, last - first);
+}
+
+[[nodiscard]] auto parseParameters(const std::string& operation,
+                                   const std::string& statement,
+                                   const size_t expected)
+    -> std::vector<double> {
+  const auto normalized = trim(statement);
+  if (normalized.size() <= operation.size() ||
+      normalized.substr(0, operation.size()) != operation ||
+      normalized[operation.size()] != '(' || normalized.back() != ';') {
+    throw std::runtime_error("Malformed canonical statement: " + statement);
+  }
+  size_t depth = 0;
+  std::optional<size_t> closingParenthesis;
+  for (size_t index = operation.size(); index < normalized.size(); ++index) {
+    if (normalized[index] == '(') {
+      ++depth;
+    } else if (normalized[index] == ')') {
+      if (depth == 0) {
+        throw std::runtime_error("Malformed gate parameters: " + statement);
+      }
+      --depth;
+      if (depth == 0) {
+        closingParenthesis = index;
+        break;
+      }
+    }
+  }
+  if (!closingParenthesis) {
+    throw std::runtime_error("Unclosed gate parameters: " + statement);
+  }
+  const auto operands = trim(normalized.substr(
+      *closingParenthesis + 1, normalized.size() - *closingParenthesis - 2));
+  if (operands.empty()) {
+    throw std::runtime_error("Missing gate operand: " + statement);
+  }
+  const auto parameterText = normalized.substr(
+      operation.size() + 1, *closingParenthesis - operation.size() - 1);
+  std::vector<double> parameters;
+  size_t start = 0;
+  depth = 0;
+  for (size_t index = 0; index <= parameterText.size(); ++index) {
+    const auto atEnd = index == parameterText.size();
+    if (!atEnd && parameterText[index] == '(') {
+      ++depth;
+    } else if (!atEnd && parameterText[index] == ')') {
+      if (depth == 0) {
+        throw std::runtime_error("Malformed gate parameter: " + statement);
+      }
+      --depth;
+    }
+    if (atEnd || (parameterText[index] == ',' && depth == 0)) {
+      const auto parameter = trim(parameterText.substr(start, index - start));
+      if (parameter.empty()) {
+        throw std::runtime_error("Empty gate parameter: " + statement);
+      }
+      parameters.emplace_back(ExpressionParser(std::string(parameter)).parse());
+      start = index + 1;
+    }
+  }
+  if (depth != 0 || parameters.size() != expected) {
+    throw std::runtime_error("Wrong gate parameter arity: " + statement);
+  }
+  return parameters;
+}
+
+[[nodiscard]] auto makeSingleQubitOperation(const std::string& operation,
+                                            const std::string& statement,
+                                            const qc::Qubit qubit)
+    -> std::shared_ptr<const qc::Operation> {
+  if (operation == "u1") {
+    return std::make_shared<qc::StandardOperation>(
+        qubit, qc::P, parseParameters(operation, statement, 1));
+  }
+  if (operation == "u2") {
+    return std::make_shared<qc::StandardOperation>(
+        qubit, qc::U2, parseParameters(operation, statement, 2));
+  }
+  if (operation == "u3") {
+    return std::make_shared<qc::StandardOperation>(
+        qubit, qc::U, parseParameters(operation, statement, 3));
+  }
+  throw std::runtime_error("Unsupported frozen one-qubit operation: " +
+                           operation);
+}
+
+[[nodiscard]] auto placementToJson(const Placement& placement)
+    -> nlohmann::json {
+  auto result = nlohmann::json::array();
+  for (size_t qubit = 0; qubit < placement.size(); ++qubit) {
+    const auto& [slm, row, column] = placement[qubit];
+    result.emplace_back(nlohmann::json{{"qubit", qubit},
+                                       {"slm", slm.get().id},
+                                       {"row", row},
+                                       {"column", column}});
+  }
+  return result;
+}
+
+[[nodiscard]] auto sortedQubits(const std::unordered_set<qc::Qubit>& qubits)
+    -> std::vector<qc::Qubit> {
+  std::vector<qc::Qubit> result(qubits.cbegin(), qubits.cend());
+  std::sort(result.begin(), result.end());
+  return result;
+}
+
+[[nodiscard]] auto
+scheduleMetadataToJson(const SQLiteScheduleMetadata& metadata)
+    -> nlohmann::json {
+  return {{"format", metadata.format},
+          {"qubits", metadata.qubits},
+          {"events", metadata.events},
+          {"gates_1q", metadata.gates1Q},
+          {"gates_2q", metadata.gates2Q},
+          {"two_qubit_layers", metadata.twoQubitLayers},
+          {"scheduled_items", metadata.scheduledItems}};
+}
+
+[[nodiscard]] auto readJsonFile(const std::filesystem::path& path)
+    -> nlohmann::json {
+  std::ifstream input(path);
+  if (!input) {
+    throw std::runtime_error("Cannot open JSON file: " + path.string());
+  }
+  nlohmann::json result;
+  input >> result;
+  if (!input.eof() && input.fail()) {
+    throw std::runtime_error("Cannot parse JSON file: " + path.string());
+  }
+  return result;
+}
+
+auto validateFrozenConfig(const nlohmann::json& configJson,
+                          const RoutingAwareCompiler::Config& config) -> void {
+  if (!configJson.is_object() || !configJson.contains("placerConfig") ||
+      !configJson.at("placerConfig").is_object() ||
+      !configJson.contains("codeGeneratorConfig") ||
+      !configJson.at("codeGeneratorConfig").is_object()) {
+    throw std::runtime_error(
+        "Frozen compiler config must contain placerConfig and "
+        "codeGeneratorConfig objects");
+  }
+  const auto& placer = configJson.at("placerConfig");
+  for (const auto* key : {"useWindow", "windowMinWidth", "windowRatio",
+                          "windowShare", "deepeningFactor", "deepeningValue",
+                          "lookaheadFactor", "reuseLevel", "maxNodes"}) {
+    if (!placer.contains(key)) {
+      throw std::runtime_error("Frozen placer config is missing key: " +
+                               std::string(key));
+    }
+  }
+  const auto& codeGenerator = configJson.at("codeGeneratorConfig");
+  for (const auto* key : {"parkingOffset", "warnUnsupportedGates"}) {
+    if (!codeGenerator.contains(key)) {
+      throw std::runtime_error("Frozen code-generator config is missing key: " +
+                               std::string(key));
+    }
+  }
+  const auto& placerConfig = config.placerConfig;
+  if (!placerConfig.useWindow || placerConfig.windowMinWidth != 8 ||
+      placerConfig.windowRatio != 1.0 || placerConfig.windowShare != 0.6 ||
+      placerConfig.deepeningFactor != 0.6F ||
+      placerConfig.deepeningValue != 0.2F ||
+      placerConfig.lookaheadFactor != 0.2F || placerConfig.reuseLevel != 5.0F ||
+      placerConfig.maxNodes != 50'000'000 ||
+      config.codeGeneratorConfig.parkingOffset != 1 ||
+      !config.codeGeneratorConfig.warnUnsupportedGates) {
+    throw std::runtime_error(
+        "Compiler config does not match the frozen QMAP 3.2 paper settings");
+  }
+}
+
+auto validateArchitectureCapacity(const Architecture& architecture,
+                                  const size_t nQubits) -> void {
+  if (architecture.storageZones.empty()) {
+    throw std::runtime_error("Architecture has no storage SLM");
+  }
+  size_t storageCapacity = 0;
+  for (const auto& slm : architecture.storageZones) {
+    if (slm->nRows == 0 || slm->nCols == 0 ||
+        slm->nRows > std::numeric_limits<size_t>::max() / slm->nCols) {
+      throw std::runtime_error("Architecture has an invalid storage SLM");
+    }
+    const auto sites = slm->nRows * slm->nCols;
+    if (storageCapacity > std::numeric_limits<size_t>::max() - sites) {
+      throw std::runtime_error("Architecture storage capacity overflows");
+    }
+    storageCapacity += sites;
+  }
+  if (nQubits > storageCapacity) {
+    throw std::runtime_error(
+        "Schedule has more qubits than architecture storage sites");
+  }
+}
+
+struct OutputCleanup {
+  std::filesystem::path temporaryNative;
+  std::filesystem::path temporaryMetadata;
+  std::filesystem::path finalNative;
+  std::filesystem::path finalMetadata;
+  bool nativePublished = false;
+  bool metadataPublished = false;
+  bool success = false;
+
+  ~OutputCleanup() {
+    if (success) {
+      return;
+    }
+    std::error_code error;
+    std::filesystem::remove(temporaryNative, error);
+    error.clear();
+    std::filesystem::remove(temporaryMetadata, error);
+    if (nativePublished) {
+      error.clear();
+      std::filesystem::remove(finalNative, error);
+    }
+    if (metadataPublished) {
+      error.clear();
+      std::filesystem::remove(finalMetadata, error);
+    }
+  }
+};
+
+} // namespace
+
+struct SQLiteScheduledLayerProvider::Impl {
+  SQLiteDatabase database;
+  SQLiteScheduleMetadata metadata;
+  SQLiteStatement layerStatement;
+  SQLiteStatement gateCountStatement;
+  size_t nextLayer = 0;
+  size_t observedEvents = 0;
+  size_t observedGates1Q = 0;
+  size_t observedGates2Q = 0;
+  bool finalized = false;
+
+  explicit Impl(const std::filesystem::path& path)
+      : database(openReadOnlyDatabase(path)),
+        metadata(loadMetadata(database.get())),
+        layerStatement(
+            database.get(),
+            "SELECT seq,kind,operation,q0,q1,statement FROM qmap_operations "
+            "WHERE layer=?1 ORDER BY kind,seq"),
+        gateCountStatement(
+            database.get(),
+            "SELECT gate_count FROM two_qubit_counts WHERE layer=?1") {
+    validateDatabase();
+  }
+
+  [[nodiscard]] static auto loadMetadata(sqlite3* database)
+      -> SQLiteScheduleMetadata {
+    SQLiteStatement statement(database, "SELECT key,value FROM metadata");
+    std::unordered_map<std::string, nlohmann::json> values;
+    while (true) {
+      const auto result = sqlite3_step(statement.get());
+      if (result == SQLITE_DONE) {
+        break;
+      }
+      if (result != SQLITE_ROW) {
+        throw std::runtime_error("Cannot read schedule metadata: " +
+                                 std::string(sqlite3_errmsg(database)));
+      }
+      const auto key = columnText(statement.get(), 0, "metadata.key");
+      const auto rawValue = columnText(statement.get(), 1, "metadata.value");
+      if (!values.emplace(key, nlohmann::json::parse(rawValue)).second) {
+        throw std::runtime_error("Duplicate schedule metadata key: " + key);
+      }
+    }
+    const auto required =
+        [&values](const std::string_view key) -> const nlohmann::json& {
+      const auto found = values.find(std::string(key));
+      if (found == values.end()) {
+        throw std::runtime_error("Missing schedule metadata key: " +
+                                 std::string(key));
+      }
+      return found->second;
+    };
+    const auto& formatValue = required("format");
+    if (!formatValue.is_string()) {
+      throw std::runtime_error("Schedule metadata format is not a string");
+    }
+    SQLiteScheduleMetadata result{
+        formatValue.get<std::string>(),
+        jsonSize(required("qubits"), "qubits"),
+        jsonSize(required("events"), "events"),
+        jsonSize(required("gates_1q"), "gates_1q"),
+        jsonSize(required("gates_2q"), "gates_2q"),
+        jsonSize(required("two_qubit_layers"), "two_qubit_layers"),
+        jsonSize(required("scheduled_items"), "scheduled_items")};
+    if (result.format != "qmap-schedule-store-v1") {
+      throw std::runtime_error("Unsupported schedule database format: " +
+                               result.format);
+    }
+    if (result.qubits > std::numeric_limits<qc::Qubit>::max() ||
+        result.gates1Q > std::numeric_limits<size_t>::max() - result.gates2Q ||
+        result.events != result.gates1Q + result.gates2Q ||
+        result.scheduledItems != result.twoQubitLayers + 1) {
+      throw std::runtime_error("Inconsistent schedule metadata counts");
+    }
+    return result;
+  }
+
+  auto validateDatabase() const -> void {
+    SQLiteStatement operations(
+        database.get(),
+        "SELECT COUNT(*),COALESCE(MIN(seq),-1),COALESCE(MAX(seq),-1),"
+        "COALESCE(SUM(CASE WHEN kind=1 THEN 1 ELSE 0 END),0),"
+        "COALESCE(SUM(CASE WHEN kind=2 THEN 1 ELSE 0 END),0),"
+        "COALESCE(SUM(CASE WHEN "
+        "typeof(seq)<>'integer' OR typeof(layer)<>'integer' OR "
+        "typeof(kind)<>'integer' OR typeof(operation)<>'text' OR "
+        "typeof(q0)<>'integer' OR "
+        "(q1 IS NOT NULL AND typeof(q1)<>'integer') OR "
+        "typeof(statement)<>'text' OR seq<0 OR layer<0 OR layer>?1 OR "
+        "kind NOT IN (1,2) OR q0<0 OR q0>=?2 OR "
+        "(q1 IS NOT NULL AND (q1<0 OR q1>=?2 OR q1=q0)) OR "
+        "(kind=1 AND (q1 IS NOT NULL OR operation NOT IN ('u1','u2','u3'))) "
+        "OR (kind=2 AND (q1 IS NULL OR operation<>'cz' OR layer>=?1)) "
+        "THEN 1 ELSE 0 END),0) FROM qmap_operations");
+    sqlite3_bind_int64(operations.get(), 1,
+                       static_cast<sqlite3_int64>(metadata.twoQubitLayers));
+    sqlite3_bind_int64(operations.get(), 2,
+                       static_cast<sqlite3_int64>(metadata.qubits));
+    if (sqlite3_step(operations.get()) != SQLITE_ROW) {
+      throw std::runtime_error("Cannot validate qmap_operations: " +
+                               std::string(sqlite3_errmsg(database.get())));
+    }
+    const auto count = checkedSize(
+        columnInt64(operations.get(), 0, "qmap_operations.count"), "events");
+    const auto minimum =
+        columnInt64(operations.get(), 1, "qmap_operations.min_seq");
+    const auto maximum =
+        columnInt64(operations.get(), 2, "qmap_operations.max_seq");
+    const auto gates1Q = checkedSize(
+        columnInt64(operations.get(), 3, "qmap_operations.gates_1q"),
+        "gates_1q");
+    const auto gates2Q = checkedSize(
+        columnInt64(operations.get(), 4, "qmap_operations.gates_2q"),
+        "gates_2q");
+    const auto invalid =
+        checkedSize(columnInt64(operations.get(), 5, "qmap_operations.invalid"),
+                    "invalid rows");
+    const auto expectedMaximum =
+        metadata.events == 0 ? int64_t{-1}
+                             : static_cast<int64_t>(metadata.events - 1);
+    if (count != metadata.events || gates1Q != metadata.gates1Q ||
+        gates2Q != metadata.gates2Q || invalid != 0 ||
+        minimum != (metadata.events == 0 ? -1 : 0) ||
+        maximum != expectedMaximum) {
+      throw std::runtime_error("qmap_operations does not match metadata");
+    }
+
+    SQLiteStatement layerCounts(
+        database.get(),
+        "SELECT COUNT(*),COALESCE(MIN(layer),-1),"
+        "COALESCE(MAX(layer),-1),COALESCE(SUM(gate_count),0),"
+        "COALESCE(SUM(CASE WHEN typeof(layer)<>'integer' OR "
+        "typeof(gate_count)<>'integer' OR layer<0 OR layer>=?1 OR "
+        "gate_count<=0 THEN 1 ELSE 0 END),0) FROM two_qubit_counts");
+    sqlite3_bind_int64(layerCounts.get(), 1,
+                       static_cast<sqlite3_int64>(metadata.twoQubitLayers));
+    if (sqlite3_step(layerCounts.get()) != SQLITE_ROW) {
+      throw std::runtime_error("Cannot validate two_qubit_counts: " +
+                               std::string(sqlite3_errmsg(database.get())));
+    }
+    const auto layers =
+        checkedSize(columnInt64(layerCounts.get(), 0, "two_qubit_counts.count"),
+                    "two_qubit_layers");
+    const auto minimumLayer =
+        columnInt64(layerCounts.get(), 1, "two_qubit_counts.min_layer");
+    const auto maximumLayer =
+        columnInt64(layerCounts.get(), 2, "two_qubit_counts.max_layer");
+    const auto totalGates =
+        checkedSize(columnInt64(layerCounts.get(), 3, "two_qubit_counts.gates"),
+                    "gates_2q");
+    const auto invalidCounts = checkedSize(
+        columnInt64(layerCounts.get(), 4, "two_qubit_counts.invalid"),
+        "invalid layer counts");
+    const auto expectedMaxLayer =
+        metadata.twoQubitLayers == 0
+            ? int64_t{-1}
+            : static_cast<int64_t>(metadata.twoQubitLayers - 1);
+    if (layers != metadata.twoQubitLayers ||
+        minimumLayer != (metadata.twoQubitLayers == 0 ? -1 : 0) ||
+        maximumLayer != expectedMaxLayer || totalGates != metadata.gates2Q ||
+        invalidCounts != 0) {
+      throw std::runtime_error("two_qubit_counts does not match metadata");
+    }
+  }
+
+  [[nodiscard]] auto expectedTwoQubitGates(const size_t layer) const -> size_t {
+    gateCountStatement.reset();
+    sqlite3_bind_int64(gateCountStatement.get(), 1,
+                       static_cast<sqlite3_int64>(layer));
+    if (sqlite3_step(gateCountStatement.get()) != SQLITE_ROW) {
+      throw std::runtime_error("Missing two_qubit_counts row for layer " +
+                               std::to_string(layer));
+    }
+    const auto result = checkedSize(
+        columnInt64(gateCountStatement.get(), 0, "gate_count"), "gate_count");
+    if (sqlite3_step(gateCountStatement.get()) != SQLITE_DONE) {
+      throw std::runtime_error("Duplicate two_qubit_counts row");
+    }
+    return result;
+  }
+
+  auto finalizeCounts() -> void {
+    if (!finalized) {
+      if (observedEvents != metadata.events ||
+          observedGates1Q != metadata.gates1Q ||
+          observedGates2Q != metadata.gates2Q) {
+        throw std::runtime_error(
+            "Streamed schedule counts do not match metadata");
+      }
+      finalized = true;
+    }
+  }
+
+  [[nodiscard]] auto next() -> std::optional<ScheduledLayer> {
+    if (nextLayer == metadata.scheduledItems) {
+      finalizeCounts();
+      return std::nullopt;
+    }
+    if (nextLayer > metadata.scheduledItems) {
+      throw std::logic_error("Schedule provider read past end");
+    }
+    const auto layerIndex = nextLayer++;
+    layerStatement.reset();
+    sqlite3_bind_int64(layerStatement.get(), 1,
+                       static_cast<sqlite3_int64>(layerIndex));
+    ScheduledLayer layer;
+    TwoQubitGateLayer twoQubitGates;
+    std::vector<bool> usedByTwoQubitGate(metadata.qubits, false);
+    std::optional<int64_t> lastSingleQubitSequence;
+    std::optional<int64_t> lastTwoQubitSequence;
+    while (true) {
+      const auto result = sqlite3_step(layerStatement.get());
+      if (result == SQLITE_DONE) {
+        break;
+      }
+      if (result != SQLITE_ROW) {
+        throw std::runtime_error("Cannot read scheduled layer: " +
+                                 std::string(sqlite3_errmsg(database.get())));
+      }
+      const auto sequence =
+          columnInt64(layerStatement.get(), 0, "qmap_operations.seq");
+      const auto kind =
+          columnInt64(layerStatement.get(), 1, "qmap_operations.kind");
+      const auto operation =
+          columnText(layerStatement.get(), 2, "qmap_operations.operation");
+      const auto rawQubit0 =
+          columnInt64(layerStatement.get(), 3, "qmap_operations.q0");
+      const auto qubit0 = static_cast<qc::Qubit>(rawQubit0);
+      const auto statement =
+          columnText(layerStatement.get(), 5, "qmap_operations.statement");
+      if (kind == 1) {
+        if (lastSingleQubitSequence && sequence <= *lastSingleQubitSequence) {
+          throw std::runtime_error("One-qubit operations are not seq ordered");
+        }
+        lastSingleQubitSequence = sequence;
+        auto owner = makeSingleQubitOperation(operation, statement, qubit0);
+        layer.singleQubitGates.emplace_back(*owner);
+        layer.ownedSingleQubitOperations.emplace_back(std::move(owner));
+        ++observedGates1Q;
+      } else {
+        if (lastTwoQubitSequence && sequence <= *lastTwoQubitSequence) {
+          throw std::runtime_error("Two-qubit operations are not seq ordered");
+        }
+        lastTwoQubitSequence = sequence;
+        const auto rawQubit1 =
+            columnInt64(layerStatement.get(), 4, "qmap_operations.q1");
+        const auto qubit1 = static_cast<qc::Qubit>(rawQubit1);
+        if (usedByTwoQubitGate[qubit0] || usedByTwoQubitGate[qubit1]) {
+          throw std::runtime_error(
+              "Qubit occurs in multiple CZ gates in one scheduled layer");
+        }
+        usedByTwoQubitGate[qubit0] = true;
+        usedByTwoQubitGate[qubit1] = true;
+        twoQubitGates.emplace_back(
+            std::array{std::min(qubit0, qubit1), std::max(qubit0, qubit1)});
+        ++observedGates2Q;
+      }
+      ++observedEvents;
+    }
+    if (layerIndex < metadata.twoQubitLayers) {
+      const auto expected = expectedTwoQubitGates(layerIndex);
+      if (twoQubitGates.size() != expected) {
+        throw std::runtime_error("CZ count mismatch in scheduled layer " +
+                                 std::to_string(layerIndex));
+      }
+      layer.twoQubitGates.emplace(std::move(twoQubitGates));
+    } else {
+      if (!twoQubitGates.empty()) {
+        throw std::runtime_error("Final scheduled item contains CZ gates");
+      }
+      layer.twoQubitGates = std::nullopt;
+    }
+    return layer;
+  }
+};
+
+SQLiteScheduledLayerProvider::SQLiteScheduledLayerProvider(
+    const std::filesystem::path& path)
+    : impl_(std::make_unique<Impl>(path)) {}
+
+SQLiteScheduledLayerProvider::~SQLiteScheduledLayerProvider() = default;
+SQLiteScheduledLayerProvider::SQLiteScheduledLayerProvider(
+    SQLiteScheduledLayerProvider&&) noexcept = default;
+auto SQLiteScheduledLayerProvider::operator=(
+    SQLiteScheduledLayerProvider&&) noexcept
+    -> SQLiteScheduledLayerProvider& = default;
+
+auto SQLiteScheduledLayerProvider::next() -> std::optional<ScheduledLayer> {
+  return impl_->next();
+}
+
+auto SQLiteScheduledLayerProvider::metadata() const
+    -> const SQLiteScheduleMetadata& {
+  return impl_->metadata;
+}
+
+auto compileSQLiteSchedule(const SQLiteStreamingCompileOptions& options)
+    -> SQLiteStreamingCompileResult {
+  if (options.nativeOutput == options.metadataJsonlOutput ||
+      std::filesystem::exists(options.nativeOutput) ||
+      std::filesystem::exists(options.metadataJsonlOutput)) {
+    throw std::runtime_error("Streaming output paths must be distinct and new");
+  }
+  const auto temporaryNative =
+      std::filesystem::path(options.nativeOutput.string() + ".tmp");
+  const auto temporaryMetadata =
+      std::filesystem::path(options.metadataJsonlOutput.string() + ".tmp");
+  if (std::filesystem::exists(temporaryNative) ||
+      std::filesystem::exists(temporaryMetadata)) {
+    throw std::runtime_error("Streaming temporary output already exists");
+  }
+
+  auto architecture =
+      Architecture::fromJSON(readJsonFile(options.architectureJson));
+  const auto configJson = readJsonFile(options.compilerConfigJson);
+  const RoutingAwareCompiler::Config config = configJson;
+  validateFrozenConfig(configJson, config);
+  SQLiteScheduledLayerProvider provider(options.scheduleDatabase);
+  const auto scheduleMetadata = provider.metadata();
+  validateArchitectureCapacity(architecture, scheduleMetadata.qubits);
+
+  OutputCleanup cleanup{temporaryNative, temporaryMetadata,
+                        options.nativeOutput, options.metadataJsonlOutput};
+  std::ofstream nativeOutput(temporaryNative, std::ios::out | std::ios::trunc);
+  std::ofstream metadataOutput(temporaryMetadata,
+                               std::ios::out | std::ios::trunc);
+  nativeOutput.exceptions(std::ios::badbit | std::ios::failbit);
+  metadataOutput.exceptions(std::ios::badbit | std::ios::failbit);
+
+  size_t chunks = 0;
+  size_t peakNativeOperationsPerChunk = 0;
+  const ScheduledLayerProvider layerProvider = [&provider]() {
+    return provider.next();
+  };
+  const StreamingChunkConsumer consumer =
+      [&](const StreamingChunkMetadata& metadata, const NAComputation& chunk) {
+        peakNativeOperationsPerChunk =
+            std::max(peakNativeOperationsPerChunk, chunk.size());
+        nlohmann::json record{{"schema", "qmap-stream-metadata-v1"},
+                              {"native_operations", chunk.size()}};
+        if (const auto* initial =
+                std::get_if<StreamingInitialPlacement>(&metadata)) {
+          nativeOutput << chunk.toString();
+          record["kind"] = "initial";
+          record["schedule"] = scheduleMetadataToJson(scheduleMetadata);
+          record["placement"] = placementToJson(initial->placement);
+        } else {
+          for (const auto& operation : chunk) {
+            nativeOutput << *operation << '\n';
+          }
+          const auto& transition = std::get<StreamingTransition>(metadata);
+          record["kind"] = "transition";
+          record["layer"] = transition.layer;
+          record["previous_reuse"] =
+              sortedQubits(transition.previousReuseQubits);
+          record["next_reuse"] = sortedQubits(transition.nextReuseQubits);
+          record["previous_placement"] =
+              placementToJson(transition.previousPlacement);
+          record["gate_placement"] = placementToJson(transition.gatePlacement);
+          record["storage_placement"] =
+              placementToJson(transition.storagePlacement);
+          record["execution_routing"] = transition.executionRouting;
+          record["storage_routing"] = transition.storageRouting;
+        }
+        metadataOutput << record.dump() << '\n';
+        ++chunks;
+      };
+
+  RoutingAwareCompiler compiler(architecture, config);
+  compiler.compileStreaming(scheduleMetadata.qubits, layerProvider, consumer);
+  nativeOutput.close();
+  metadataOutput.close();
+  std::filesystem::rename(temporaryNative, options.nativeOutput);
+  cleanup.nativePublished = true;
+  std::filesystem::rename(temporaryMetadata, options.metadataJsonlOutput);
+  cleanup.metadataPublished = true;
+  cleanup.success = true;
+  return {scheduleMetadata, chunks, peakNativeOperationsPerChunk,
+          compiler.getStatistics()};
+}
+
