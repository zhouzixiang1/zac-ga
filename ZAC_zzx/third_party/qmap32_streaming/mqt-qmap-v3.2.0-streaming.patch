+
+[[nodiscard]] auto
+makeScheduledLayersIncrementally(const ASAPScheduler& scheduler,
+                                 const qc::QuantumComputation& circuit)
+    -> std::vector<ScheduledLayer> {
+  if (circuit.empty()) {
+    return {};
+  }
+  ASAPScheduler::State state(circuit.getNqubits());
+  std::vector<SingleQubitGateLayer> singleQubitGateLayers(1);
+  std::vector<TwoQubitGateLayer> twoQubitGateLayers;
+  for (const auto& op : circuit) {
+    const auto assignment = scheduler.scheduleOperation(*op, state);
+    while (twoQubitGateLayers.size() < state.twoQubitGateCounts.size()) {
+      singleQubitGateLayers.emplace_back();
+      twoQubitGateLayers.emplace_back();
+    }
+    if (assignment.kind == ASAPScheduler::OperationKind::SingleQubit) {
+      singleQubitGateLayers[assignment.layer].emplace_back(*op);
+    } else if (assignment.kind == ASAPScheduler::OperationKind::TwoQubit) {
+      twoQubitGateLayers[assignment.layer].emplace_back(assignment.qubits);
+    }
+  }
+  std::vector<ScheduledLayer> layers;
+  layers.reserve(singleQubitGateLayers.size());
+  for (size_t layer = 0; layer < singleQubitGateLayers.size(); ++layer) {
+    layers.emplace_back(ScheduledLayer{
+        singleQubitGateLayers[layer],
+        layer < twoQubitGateLayers.size()
+            ? std::optional<TwoQubitGateLayer>{twoQubitGateLayers[layer]}
+            : std::nullopt,
+        {}});
+  }
+  return layers;
+}
+
+[[nodiscard]] auto compilerOperationsToString(const NAComputation& code)
+    -> std::string {
+  std::ostringstream output;
+  for (const auto& op : code) {
+    output << *op << "\n";
+  }
