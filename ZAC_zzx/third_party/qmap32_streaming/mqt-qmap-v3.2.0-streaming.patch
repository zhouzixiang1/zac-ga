+TEST(SQLiteStreamingTest, MatchesBatchNativeOutputExactly) {
+  const TemporaryDirectory temporary;
+  const auto database = temporary.path() / "schedule.sqlite";
+  const auto architecturePath = temporary.path() / "architecture.json";
+  const auto configPath = temporary.path() / "config.json";
+  const auto nativePath = temporary.path() / "program.naviz";
+  const auto metadataPath = temporary.path() / "program.metadata.jsonl";
+  const std::vector<ScheduleRow> rows{
+      {0, 0, 1, "u1", 0, std::nullopt, "u1(0.123) q[0];"},
+      {1, 0, 2, "cz", 0, 1, "cz q[0],q[1];"},
+      {2, 1, 1, "u2", 1, std::nullopt, "u2(0.234,-0.345) q[1];"},
+      {3, 1, 2, "cz", 1, 2, "cz q[1],q[2];"},
+      {4, 2, 1, "u3", 2, std::nullopt, "u3(0.456,0.567,-0.678) q[2];"}};
+  createScheduleDatabase(database, 4, rows, {1, 1});
+  writeText(architecturePath, sqliteArchitecture);
+  writeText(configPath, sqliteCompilerConfig);
+
+  const auto result = compileSQLiteSchedule(
+      {database, architecturePath, configPath, nativePath, metadataPath});
+  EXPECT_EQ(result.schedule.format, "qmap-schedule-store-v1");
+  EXPECT_EQ(result.schedule.events, rows.size());
+  EXPECT_EQ(result.chunks, 3U);
+  EXPECT_GT(result.peakNativeOperationsPerChunk, 0U);
+  const nlohmann::json statistics = result.statistics;
+  EXPECT_EQ(statistics.at("totalTime"),
+            statistics.at("schedulingTime").get<int64_t>() +
+                statistics.at("reuseAnalysisTime").get<int64_t>() +
+                statistics.at("placementTime").get<int64_t>() +
+                statistics.at("routingTime").get<int64_t>() +
+                statistics.at("codeGenerationTime").get<int64_t>());
+
+  const auto architecture =
+      Architecture::fromJSONString(std::string(sqliteArchitecture));
+  const RoutingAwareCompiler::Config config =
+      nlohmann::json::parse(sqliteCompilerConfig);
+  qc::QuantumComputation circuit(4);
+  circuit.p(0.123, 0);
+  circuit.cz(0, 1);
+  circuit.u2(0.234, -0.345, 1);
+  circuit.cz(1, 2);
+  circuit.u(0.456, 0.567, -0.678, 2);
+  RoutingAwareCompiler batchCompiler(architecture, config);
+  const auto batch = batchCompiler.compile(circuit);
+  EXPECT_EQ(readText(nativePath), batch.toString());
+
+  std::ifstream metadataInput(metadataPath);
+  std::vector<nlohmann::json> metadataRecords;
+  for (std::string line; std::getline(metadataInput, line);) {
+    metadataRecords.emplace_back(nlohmann::json::parse(line));
+  }
+  ASSERT_EQ(metadataRecords.size(), 3U);
+  EXPECT_EQ(metadataRecords.front().at("kind"), "initial");
+  EXPECT_EQ(metadataRecords.front().at("schedule").at("events"), rows.size());
+  EXPECT_EQ(metadataRecords[1].at("kind"), "transition");
+  EXPECT_EQ(metadataRecords[1].at("layer"), 0);
+  EXPECT_EQ(metadataRecords[2].at("layer"), 1);
+  EXPECT_FALSE(std::filesystem::exists(nativePath.string() + ".tmp"));
+  EXPECT_FALSE(std::filesystem::exists(metadataPath.string() + ".tmp"));
+}
+
+TEST(SQLiteStreamingTest, ReleasesLayersOutsideCurrentNextWindow) {
+  const TemporaryDirectory temporary;
+  const auto database = temporary.path() / "many-layers.sqlite";
+  constexpr size_t layerCount = 2048;
+  std::vector<ScheduleRow> rows;
+  rows.reserve((2 * layerCount) + 1);
+  for (size_t layer = 0; layer < layerCount; ++layer) {
+    rows.emplace_back(ScheduleRow{2 * layer, layer, 1, "u1", 0, std::nullopt,
+                                  "u1(pi/7) q[0];"});
+    rows.emplace_back(
+        ScheduleRow{(2 * layer) + 1, layer, 2, "cz", 0, 1, "cz q[0],q[1];"});
+  }
+  rows.emplace_back(ScheduleRow{2 * layerCount, layerCount, 1, "u1", 0,
+                                std::nullopt, "u1(-pi/9) q[0];"});
+  createScheduleDatabase(database, 2, rows, std::vector<size_t>(layerCount, 1));
+
+  SQLiteScheduledLayerProvider provider(database);
+  auto current = provider.next();
+  auto next = provider.next();
+  ASSERT_TRUE(current);
+  ASSERT_TRUE(next);
+  ASSERT_EQ(current->ownedSingleQubitOperations.size(), 1U);
+  std::weak_ptr<const qc::Operation> firstOwner =
+      current->ownedSingleQubitOperations.front();
+  size_t items = 1;
+  size_t maxLiveOwnedOperations = 0;
+  while (current) {
+    const auto currentOwners = current->ownedSingleQubitOperations.size();
+    const auto nextOwners =
+        next ? next->ownedSingleQubitOperations.size() : size_t{0};
+    maxLiveOwnedOperations =
+        std::max(maxLiveOwnedOperations, currentOwners + nextOwners);
+    current = std::move(next);
+    next = provider.next();
+    ++items;
+    if (items == 2) {
+      EXPECT_TRUE(firstOwner.expired());
+    }
+  }
+  EXPECT_EQ(items, layerCount + 2);
+  EXPECT_LE(maxLiveOwnedOperations, 2U);
+  EXPECT_FALSE(next);
+}
+
+TEST(SQLiteStreamingTest, FailsClosedAndDoesNotPublishPartialOutput) {
+  const TemporaryDirectory temporary;
+  const auto database = temporary.path() / "invalid.sqlite";
+  const auto architecturePath = temporary.path() / "architecture.json";
+  const auto configPath = temporary.path() / "config.json";
+  const auto nativePath = temporary.path() / "program.naviz";
+  const auto metadataPath = temporary.path() / "program.metadata.jsonl";
+  createScheduleDatabase(
+      database, 1, {{0, 0, 1, "u1", 0, std::nullopt, "u1(not_a_number) q[0];"}},
+      {});
+  writeText(architecturePath, sqliteArchitecture);
+  writeText(configPath, sqliteCompilerConfig);
+
+  EXPECT_THROW(
+      std::ignore = compileSQLiteSchedule(
+          {database, architecturePath, configPath, nativePath, metadataPath}),
+      std::runtime_error);
+  EXPECT_FALSE(std::filesystem::exists(nativePath));
+  EXPECT_FALSE(std::filesystem::exists(metadataPath));
+  EXPECT_FALSE(std::filesystem::exists(nativePath.string() + ".tmp"));
+  EXPECT_FALSE(std::filesystem::exists(metadataPath.string() + ".tmp"));
+}
+
+TEST(SQLiteStreamingTest, RejectsNonFrozenPaperConfiguration) {
+  const TemporaryDirectory temporary;
