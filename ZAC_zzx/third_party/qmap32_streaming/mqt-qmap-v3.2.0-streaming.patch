+struct ScheduleRow {
+  size_t sequence;
+  size_t layer;
+  int kind;
+  std::string operation;
+  size_t qubit0;
+  std::optional<size_t> qubit1;
+  std::string statement;
+};
+
+class TemporaryDirectory {
+  std::filesystem::path path_;
+
+public:
+  TemporaryDirectory() {
+    static std::atomic<size_t> counter{0};
+    const auto nonce =
+        std::chrono::steady_clock::now().time_since_epoch().count();
+    path_ = std::filesystem::temp_directory_path() /
+            ("mqt-qmap-sqlite-streaming-" + std::to_string(nonce) + "-" +
+             std::to_string(counter.fetch_add(1)));
+    std::filesystem::create_directory(path_);
+  }
+
+  ~TemporaryDirectory() {
+    std::error_code error;
+    std::filesystem::remove_all(path_, error);
+  }
+
+  [[nodiscard]] auto path() const -> const std::filesystem::path& {
+    return path_;
+  }
+};
+
+auto sqliteCheck(sqlite3* database, const int result,
+                 const std::string& context) -> void {
+  if (result != SQLITE_OK) {
+    throw std::runtime_error(context + ": " + sqlite3_errmsg(database));
+  }
+}
+
+auto createScheduleDatabase(const std::filesystem::path& path,
+                            const size_t qubits,
+                            const std::vector<ScheduleRow>& rows,
+                            const std::vector<size_t>& twoQubitCounts) -> void {
+  sqlite3* database = nullptr;
+  if (sqlite3_open(path.string().c_str(), &database) != SQLITE_OK) {
+    const auto message = database == nullptr ? std::string("open failed")
+                                             : sqlite3_errmsg(database);
+    sqlite3_close(database);
+    throw std::runtime_error(message);
+  }
+  const auto closeDatabase = [&database]() { sqlite3_close(database); };
+  try {
+    sqliteCheck(database,
+                sqlite3_exec(
+                    database,
+                    "CREATE TABLE metadata(key TEXT PRIMARY KEY,value TEXT);"
+                    "CREATE TABLE qmap_operations("
+                    "seq INTEGER PRIMARY KEY,layer INTEGER,kind INTEGER,"
+                    "operation TEXT,q0 INTEGER,q1 INTEGER NULL,statement TEXT);"
+                    "CREATE INDEX qmap_operations_by_layer "
+                    "ON qmap_operations(layer,kind,seq);"
+                    "CREATE TABLE two_qubit_counts("
+                    "layer INTEGER PRIMARY KEY,gate_count INTEGER);"
+                    "BEGIN;",
+                    nullptr, nullptr, nullptr),
+                "create fixture schema");
+
+    sqlite3_stmt* operationStatement = nullptr;
+    sqliteCheck(
+        database,
+        sqlite3_prepare_v2(database,
+                           "INSERT INTO qmap_operations VALUES(?,?,?,?,?,?,?)",
+                           -1, &operationStatement, nullptr),
+        "prepare operation insert");
+    for (const auto& row : rows) {
+      sqlite3_bind_int64(operationStatement, 1,
+                         static_cast<sqlite3_int64>(row.sequence));
+      sqlite3_bind_int64(operationStatement, 2,
+                         static_cast<sqlite3_int64>(row.layer));
+      sqlite3_bind_int(operationStatement, 3, row.kind);
+      sqlite3_bind_text(operationStatement, 4, row.operation.c_str(), -1,
+                        SQLITE_TRANSIENT);
+      sqlite3_bind_int64(operationStatement, 5,
+                         static_cast<sqlite3_int64>(row.qubit0));
+      if (row.qubit1) {
+        sqlite3_bind_int64(operationStatement, 6,
+                           static_cast<sqlite3_int64>(*row.qubit1));
+      } else {
+        sqlite3_bind_null(operationStatement, 6);
+      }
+      sqlite3_bind_text(operationStatement, 7, row.statement.c_str(), -1,
+                        SQLITE_TRANSIENT);
+      if (sqlite3_step(operationStatement) != SQLITE_DONE) {
+        sqlite3_finalize(operationStatement);
+        throw std::runtime_error("insert operation failed");
+      }
+      sqlite3_reset(operationStatement);
+      sqlite3_clear_bindings(operationStatement);
+    }
+    sqlite3_finalize(operationStatement);
+
+    sqlite3_stmt* countStatement = nullptr;
+    sqliteCheck(database,
+                sqlite3_prepare_v2(database,
+                                   "INSERT INTO two_qubit_counts VALUES(?,?)",
+                                   -1, &countStatement, nullptr),
+                "prepare layer-count insert");
+    for (size_t layer = 0; layer < twoQubitCounts.size(); ++layer) {
+      sqlite3_bind_int64(countStatement, 1, static_cast<sqlite3_int64>(layer));
+      sqlite3_bind_int64(countStatement, 2,
+                         static_cast<sqlite3_int64>(twoQubitCounts[layer]));
+      if (sqlite3_step(countStatement) != SQLITE_DONE) {
+        sqlite3_finalize(countStatement);
+        throw std::runtime_error("insert layer count failed");
+      }
+      sqlite3_reset(countStatement);
+      sqlite3_clear_bindings(countStatement);
+    }
+    sqlite3_finalize(countStatement);
+
+    size_t gates1Q = 0;
+    size_t gates2Q = 0;
+    for (const auto& row : rows) {
+      if (row.kind == 1) {
+        ++gates1Q;
+      } else {
+        ++gates2Q;
+      }
+    }
+    const std::vector<std::pair<std::string, nlohmann::json>> metadata{
+        {"format", "qmap-schedule-store-v1"},
+        {"qubits", qubits},
+        {"events", rows.size()},
+        {"gates_1q", gates1Q},
+        {"gates_2q", gates2Q},
+        {"two_qubit_layers", twoQubitCounts.size()},
+        {"scheduled_items", twoQubitCounts.size() + 1}};
+    sqlite3_stmt* metadataStatement = nullptr;
+    sqliteCheck(database,
+                sqlite3_prepare_v2(database, "INSERT INTO metadata VALUES(?,?)",
+                                   -1, &metadataStatement, nullptr),
+                "prepare metadata insert");
+    for (const auto& [key, value] : metadata) {
+      const auto serialized = value.dump();
+      sqlite3_bind_text(metadataStatement, 1, key.c_str(), -1,
+                        SQLITE_TRANSIENT);
+      sqlite3_bind_text(metadataStatement, 2, serialized.c_str(), -1,
+                        SQLITE_TRANSIENT);
+      if (sqlite3_step(metadataStatement) != SQLITE_DONE) {
+        sqlite3_finalize(metadataStatement);
+        throw std::runtime_error("insert metadata failed");
+      }
+      sqlite3_reset(metadataStatement);
+      sqlite3_clear_bindings(metadataStatement);
+    }
+    sqlite3_finalize(metadataStatement);
+    sqliteCheck(database,
+                sqlite3_exec(database, "COMMIT;", nullptr, nullptr, nullptr),
+                "commit fixture");
+  } catch (...) {
+    closeDatabase();
+    throw;
+  }
+  closeDatabase();
+}
+
+auto writeText(const std::filesystem::path& path, const std::string_view text)
+    -> void {
+  std::ofstream output(path);
+  output << text;
+  if (!output) {
+    throw std::runtime_error("cannot write fixture text");
+  }
+}
+
+[[nodiscard]] auto readText(const std::filesystem::path& path) -> std::string {
+  std::ifstream input(path);
+  return {std::istreambuf_iterator<char>(input),
+          std::istreambuf_iterator<char>()};
+}
