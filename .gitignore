# The only maintained project is this root. Archives are local, never a release.
/archive/

# Newly supplied reference PDF stays local; no redistribution permission recorded.
/documents/ZAP_Zoned_Architecture_and_Performant_Compiler_for_Field-Programmable_Atom_Array.pdf

# Render-only scratch material.
tmp/

# Unified generated output lives within the active manuscript directory.
/IEEE_conference_template/build/
# Machine-local frozen raw runs and historic worktree material.
/fidelity-lookahead-v2/

# Current supplementary studies: keep protocols, summaries and per-job scores
# reviewable; retain full native traces and compiler logs locally only.
/ZAC_zzx/results/initial_lookahead_v1/*/jobs/*/*
!/ZAC_zzx/results/initial_lookahead_v1/*/jobs/*/protocol.json
!/ZAC_zzx/results/initial_lookahead_v1/*/jobs/*/summary.json
!/ZAC_zzx/results/initial_lookahead_v1/*/jobs/*/h0_result.json
!/ZAC_zzx/results/initial_lookahead_v1/*/jobs/*/h2_result.json
!/ZAC_zzx/results/initial_lookahead_v1/*/jobs/*/sa_reference_result.json
/ZAC_zzx/results/initial_lookahead_v1/*/receipts/*
!/ZAC_zzx/results/initial_lookahead_v1/*/receipts/*.json
/ZAC_zzx/results/initial_lookahead_v1/**/raw/
/ZAC_zzx/results/initial_lookahead_v1/**/runs/
/ZAC_zzx/results/horizon_extension_v1/runs/
/ZAC_zzx/results/horizon_extension_v1/raw/
/ZAC_zzx/results/horizon_extension_v2/runs/
/ZAC_zzx/results/horizon_extension_v2/.quality.lock
# Independent refinement keeps compact scores/receipts in Git, raw ZAIR locally.
/ZAC_zzx/results/refinement_v1/**/*.json.gz
/ZAC_zzx/results/refinement_v1/**/compiler.log
# Default-initialization study: preserve compact evidence, keep raw output local.
/ZAC_zzx/results/default_initial_v1/**/native_trace.json.gz
/ZAC_zzx/results/default_initial_v1/**/compiler.log
/ZAC_zzx/results/default_initial_v1/.execution.lock
/ZAC_zzx/results/default_initial_v1/.expansion.lock
/ZAC_zzx/results/default_initial_v1/recovery/.recovery.lock
/ZAC_zzx/results/default_initial_v1/**/receipts/*.log
